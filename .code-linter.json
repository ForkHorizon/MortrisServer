{
  "max_file_lines": 500,
  "max_function_lines": 150,
  "max_nesting_depth": 6,
  "max_parameters": 10,
  "max_comment_lines": 25,
  "max_types_per_file": 15,
  "include_extensions": [
    ".go",
    ".py"
  ],
  "ignore": [
    ".ci-gates",
    ".git",
    "build",
    "dist",
    "node_modules",
    "vendor"
  ],
  "language_overrides": {}
}
